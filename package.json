{
  "name": "supplierinvoice-cap",
  "version": "1.0.0",
  "description": "SAP CAP application for Supplier Invoice Processing - Full CRUD Proxy for API_SUPPLIERINVOICE_PROCESS_SRV",
  "main": "srv/service.js",
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build": "mbt build",
    "clean": "rimraf gen mta_archives"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@sap/cds": "^7.9.5",
    "@sap/cds-dk": "^7.9.0",
    "express": "^4.18.2",
    "@sap/xssec": "^3.6.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@sap/cds-dk": "^7.9.0",
    "mbt": "^1.2.18",
    "rimraf": "^5.0.5"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "API_SUPPLIERINVOICE_PROCESS_SRV": {
          "kind": "odata",
          "model": "srv/external/API_SUPPLIERINVOICE_PROCESS_SRV",
          "credentials": {
            "url": "http://mygohanafun2023:8000",
            "destination": "API_SUPPLIERINVOICE_PROCESS_SRV",
            "path": "/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV/",
            "authentication": "BasicAuthentication",
            "forwardAuthToken": true,
            "proxy": "sap-cloud-connectivity-proxy"
          }
        }
      },
      "API_SUPPLIERINVOICE_PROCESS_SRV": {
        "kind": "odata",
        "model": "srv/external/API_SUPPLIERINVOICE_PROCESS_SRV",
        "credentials": {
          "destination": "API_SUPPLIERINVOICE_PROCESS_SRV",
          "path": "/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV/"
        }
      }
    }
  },
  "sap-cloud": {
    "service": "supplierinvoice-cap"
  }
}
